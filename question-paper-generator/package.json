{
  "name": "question-paper-generator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --watch index.js",
    "start": "node index.js",
    "worker": "node worker.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "check": "node scripts/check.js",
    "seed": "node scripts/seed.js",
    "admin": "node scripts/admin.js",
    "db:indexes": "node scripts/indexes.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "ajv": "^8.17.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.0.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.12.0",
    "mongoose": "^8.19.0",
    "multer": "^2.0.2",
    "openai": "^6.0.0",
    "pdfjs-dist": "^6.3.289",
    "pdfkit": "^0.17.0",
    "pino": "^9.9.0",
    "prom-client": "^15.1.3",
    "twilio": "^5.0.0",
    "yauzl": "^3.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "jest": "^30.0.0",
    "mongodb-memory-server": "^10.0.0",
    "supertest": "^7.1.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "setupFiles": [
      "<rootDir>/tests/helpers/env.js"
    ],
    "testTimeout": 120000,
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/tests/"
    ]
  }
}
