NODE_ENV=development
PORT=8080
MONGO_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
MONGO_DB_NAME=questmind
REDIS_URL=redis://127.0.0.1:6379
# Generate two different random secrets (at least 32 characters).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=questmind
JWT_AUDIENCE=questmind-client
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
SUPPORTED_COUNTRIES=IN
AWS_REGION=ap-south-1
# Prefer IAM task/workload roles in production; omit static credentials there.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
S3_URL_TTL_SECONDS=300
LLM_PROVIDER=disabled
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=60000
LLM_MAX_OUTPUT_TOKENS=6000
EMBEDDING_PROVIDER=disabled
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# Select 'openai' and an account-supported model to enable AI. No mock in production.
DIKSHA_ENABLED=false
# Reserved for a future reviewed, authorized adapter; no guessed endpoints are called.
DIKSHA_API_BASE_URL=
DIKSHA_API_KEY=
NCERT_ENABLED=true
LICENSED_ENABLED=false
COMMERCIAL_MODE=true
MAX_BOOK_SIZE_MB=100
MAX_SAMPLE_PAPER_SIZE_MB=20
MAX_EXTRACTED_CHARACTERS=1000000
MAX_BOOK_PAGES=1500
MAX_ARCHIVE_ENTRIES=3000
MAX_ARCHIVE_EXPANDED_MB=150
MAX_CHUNKS_PER_BOOK=2500
MAX_QUESTIONS_PER_PAPER=100
MAX_CHAPTERS_PER_GENERATION=10
MAX_CONTEXT_TOKENS=6000
RETRIEVAL_TOP_K=6
MAX_RETRIEVAL_CANDIDATES=2500
MAX_QUESTION_RETRIES=3
OTP_SEND_LIMIT=5
OTP_MAX_ATTEMPTS=10
OTP_RATE_LIMIT_WINDOW=900
OTP_IP_LIMIT=20
OTP_IP_WINDOW=3600
GENERATION_RATE_LIMIT=10
MAX_GENERATIONS_PER_HOUR=10
MAX_CONCURRENT_GENERATIONS=2
UPLOAD_RATE_LIMIT=10
API_RATE_LIMIT=300
API_RATE_WINDOW=60
IDEMPOTENCY_TTL_SECONDS=86400
JOB_ATTEMPTS=3
JOB_BACKOFF_MS=5000
JOB_TIMEOUT_MS=900000
WORKER_CONCURRENCY=2
QUEUE_KEEP_COMPLETED=1000
QUEUE_KEEP_FAILED=5000
JOB_RETENTION_DAYS=30
CLEANUP_INTERVAL_MS=3600000
CORS_ORIGIN=http://localhost:3000
# Explicit trusted proxy IPs/CIDRs only. Empty means trust no proxy.
TRUST_PROXY=
LOG_LEVEL=info
UPLOAD_TEMP_DIR=/tmp/questmind-uploads
PDF_TITLE=QuestMind
PDF_FONT_PATH=
PDF_BOLD_FONT_PATH=
# Per-medium fonts mounted inside API/worker containers, e.g. Hindi and Tamil.
PDF_FONTS_JSON={}
